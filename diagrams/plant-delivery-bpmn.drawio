    <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" source="p4_l1_checkinv" target="p4_l1_gw_inv" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Gateway NO (stock OK) → End -->
    <mxCell id="e20" value="NO" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;fontStyle=1;" edge="1" source="p4_l1_gw_inv" target="p4_l1_end_no" parent="1">
