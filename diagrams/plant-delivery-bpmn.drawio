    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SEQUENCE FLOW EDGES — Main Order Process                    -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Start → Record Order (cross pool, message flow) -->
    <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#0066CC;" edge="1" source="s_start_order" target="p2_l1_record" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Record Order → Order Confirmation Flow (cross pool, message) -->
    <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" source="p2_l1_record" target="p4_l1_orderconf" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Record Order → Reserve Stock (within pool) -->
    <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" source="p2_l1_record" target="p2_l2_reserve" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Reserve Stock → Gateway: Stock Sufficient? -->
    <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" source="p2_l2_reserve" target="p2_l2_gw_stock" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Gateway YES → Auto-assign Driver -->
    <mxCell id="e5" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;fontStyle=1;" edge="1" source="p2_l2_gw_stock" target="p2_l3_assign" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Gateway NO → Trigger Reorder -->
    <mxCell id="e6" value="NO" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;fontStyle=1;" edge="1" source="p2_l2_gw_stock" target="p2_l2_reorder" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Reorder → Warehouse Alert (cross pool) -->
    <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#d79b00;" edge="1" source="p2_l2_reorder" target="p3_l1_alert" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Warehouse Alert → Wait for Restock (intermediate timer) -->
    <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" source="p3_l1_alert" target="p3_l1_wait" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Wait for Restock → Auto-assign Driver (rejoin main flow, cross pool) -->
    <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;dashed=1;" edge="1" source="p3_l1_wait" target="p2_l3_assign" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Auto-assign → Create Delivery Record -->
    <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" source="p2_l3_assign" target="p2_l3_delrec" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Create Delivery Record → Send Notification (cross pool, to Power Automate) -->
    <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;" edge="1" source="p2_l3_delrec" target="p4_l1_sendnotif" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Send Notification → Driver Receives (cross pool, message flow) -->
    <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#9673a6;" edge="1" source="p4_l1_sendnotif" target="p3_l2_notif" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Driver Receives → Pick Up -->
    <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" source="p3_l2_notif" target="p3_l2_pickup" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Pick Up → In Transit -->
    <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" source="p3_l2_pickup" target="p3_l2_transit" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- In Transit → Delivered -->
    <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" source="p3_l2_transit" target="p3_l2_delivered" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Delivered → Office Confirms Receipt (cross pool, message flow) -->
    <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#6c8ebf;" edge="1" source="p3_l2_delivered" target="p1_l1_confirm" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Office Confirms → End Event -->
    <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" source="p1_l1_confirm" target="s_end_order" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SEQUENCE FLOW — Inventory Automation Sub-Process            -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;" edge="1" source="p4_l1_timer_daily" target="p4_l1_checkinv" parent="1">
