    <!-- Gateway YES → Send Low Stock Alert -->
    <mxCell id="e21" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;fontStyle=1;" edge="1" source="p4_l1_gw_inv" target="p4_l1_lowalert" parent="1">
