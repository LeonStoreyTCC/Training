    <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;" edge="1" source="p4_l1_lowalert" target="p4_l1_autoreorder" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;" edge="1" source="p4_l1_autoreorder" target="p4_l1_end_yes" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════ -->
